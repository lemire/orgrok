{
  "version": 1,
  "description": "Economic model parameters for Orion Reborn. Based on classic Master of Orion factory + population production with robotics limits.",
  "base_parameters": {
    "worker_output": 0.5,
    "factory_output": 1.0,
    "base_factories_per_pop": 2,
    "base_growth_points_cost": 100,
    "growth_cost_multiplier": 0.15,
    "base_growth_rate": 0.045
  },
  "growth_model": {
    "type": "growth_points",
    "description": "Each planet accumulates growth points. When points reach the cost for the next population unit, population increases by 1.",
    "formulas": {
      "growth_points_needed": "base_cost * (1 + growth_cost_multiplier * current_population)",
      "points_per_turn": "base_growth_rate * food_factor * crowding_factor * race_growth_modifier * building_modifiers"
    },
    "crowding_formula": "max(0, 1 - (current_pop / (max_pop * 1.1)))",
    "notes": "Food factor comes from the separate food system (surplus/deficit)."
  },
  "industrial_output_model": {
    "formula": "total_production = (population * worker_output) + (effective_factories * factory_output)",
    "effective_factories": "min(total_factories, population * factories_per_pop)",
    "factories_per_pop": {
      "base": 2,
      "increases_via_tech": ["Improved Robotics I", "Improved Robotics II", ...]
    }
  },
  "modifiers": {
    "planet_richness": {
      "poor":      { "production_multiplier": 0.65 },
      "average":   { "production_multiplier": 1.0 },
      "rich":      { "production_multiplier": 1.5 },
      "ultra_rich": { "production_multiplier": 2.0 }
    },
    "buildings": {
      "auto_factory":     { "production_bonus": 0.13 },
      "cloning_center":   { "growth_bonus": 0.4 },
      "housing":          { "max_pop_increase": 2 },
      "pollution_control": { "pollution_reduction": 0.5 }
    },
    "race_traits": {
      "example_sakkra": { "growth_multiplier": 1.5, "production_multiplier": 0.9 },
      "example_mrrshan": { "growth_multiplier": 0.8, "production_multiplier": 1.3 }
    }
  },
  "pollution": {
    "base_pollution_per_factory": 0.28,
    "effect_on_growth": "-20% to -60% depending on severity",
    "cleanup_allocation": "Ecology slider reduces pollution and can repair damage"
  },
  "tuning_notes": [
    "Early game: Factory construction is the main bottleneck.",
    "Mid game: Robotics tech dramatically increases effective factories.",
    "Late game: Large planets with high robotics become production powerhouses, but pollution and crowding create meaningful trade-offs."
  ]
}